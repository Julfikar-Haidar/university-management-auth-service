{
  "name": "university-management-auth-service",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint:check": "eslint .eslintignore \"src/**/*.+(js|ts|json)\"",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "lint:staged": "eslint",
    "prettier:check": "prettier --ignore-path .prettierignore --check \"src/**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --ignore-path .prettierignore --write \"**/*.+(js|ts|json)\"",
    "prettier:staged": "prettier --ignore-path .prettierignore --write",
    "lint-prettier:check": "yarn  lint:check && yarn  prettier:check",
    "lint-prettier:fix": "yarn  lint:fix && yarn  prettier:fix",
    "eslint:migrate": "npx @eslint/migrate-config .eslintrc.json"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint"
    }
  },
  "lint-staged": {
    "src/**/*.{js,ts,json,css,scss,md}": [
      "yarn run lint:staged",
      "yarn run prettier:staged"
    ],
    "src/**/*.{json,css,md,mjs}": [
      "prettier --write"
    ]
  },
  "author": "Julfikar",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/nodemailer": "^6.4.13",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@eslint/migrate-config": "^1.3.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "http-status": "^1.6.2",
    "init": "^0.1.2",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.6.0",
    "nodemailer": "^6.9.7",
    "redis": "^4.6.8",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.21.4"
  }
}
